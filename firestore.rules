rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    // Qualquer autenticado pode ler (necessário para admin listar todos).
    // Criação apenas do próprio documento (registro).
    // Atualização apenas por admin.
    // Exclusão bloqueada — deve ser via Cloud Function deleteUserAccount.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'aluno'
                    && request.resource.data.status == 'active';

      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow delete: if false;
    }

    // ── WODs (Treinos do Dia) ──
    // Leitura para qualquer autenticado.
    // Escrita apenas para professor ou admin.
    match /wods/{wodId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['professor', 'admin'];
    }

    // ── Checkins ──
    // Leitura para qualquer autenticado.
    // Escrita para qualquer autenticado (alunos fazem self-checkin).
    match /checkins/{checkinId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Rankings ──
    // Leitura para qualquer autenticado.
    // Escrita no documento pai: qualquer autenticado (auto-criação).
    match /rankings/{rankingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // Scores: atleta escreve/apaga somente o próprio doc (scoreId == uid).
      // Professor/admin pode escrever/apagar qualquer score.
      match /scores/{scoreId} {
        allow read: if request.auth != null;

        // Atleta cria/atualiza apenas seu próprio score
        allow create, update: if request.auth != null
                     && (request.auth.uid == scoreId
                         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['professor', 'admin']);

        // Atleta exclui apenas seu próprio score; prof/admin exclui qualquer um
        allow delete: if request.auth != null
                     && (request.auth.uid == scoreId
                         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['professor', 'admin']);
      }
    }

    // ── Bloquear todo o resto ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
